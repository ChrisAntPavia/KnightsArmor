<?xml version="1.0" encoding="utf-8"?>
<!-- Interactive campus map placeholder with color-coded report pins -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/campus_map"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_campus_map"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/pin_events"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/cd_pin"
        android:src="@drawable/ic_pin"
        app:layout_constraintBottom_toBottomOf="@id/campus_map"
        app:layout_constraintEnd_toEndOf="@id/campus_map"
        app:layout_constraintHorizontal_bias="0.8"
        app:layout_constraintStart_toStartOf="@id/campus_map"
        app:layout_constraintTop_toTopOf="@id/campus_map"
        app:layout_constraintVertical_bias="0.12"
        app:tint="@color/pin_events" />

    <ImageView
        android:id="@+id/pin_water"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/cd_pin"
        android:src="@drawable/ic_pin"
        app:layout_constraintBottom_toBottomOf="@id/campus_map"
        app:layout_constraintEnd_toEndOf="@id/campus_map"
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toStartOf="@id/campus_map"
        app:layout_constraintTop_toTopOf="@id/campus_map"
        app:layout_constraintVertical_bias="0.3"
        app:tint="@color/pin_water" />

    <ImageView
        android:id="@+id/pin_alerts"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/cd_pin"
        android:src="@drawable/ic_pin"
        app:layout_constraintBottom_toBottomOf="@id/campus_map"
        app:layout_constraintEnd_toEndOf="@id/campus_map"
        app:layout_constraintHorizontal_bias="0.68"
        app:layout_constraintStart_toStartOf="@id/campus_map"
        app:layout_constraintTop_toTopOf="@id/campus_map"
        app:layout_constraintVertical_bias="0.62"
        app:tint="@color/pin_alerts" />

    <ImageView
        android:id="@+id/pin_events_2"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/cd_pin"
        android:src="@drawable/ic_pin"
        app:layout_constraintBottom_toBottomOf="@id/campus_map"
        app:layout_constraintEnd_toEndOf="@id/campus_map"
        app:layout_constraintHorizontal_bias="0.3"
        app:layout_constraintStart_toStartOf="@id/campus_map"
        app:layout_constraintTop_toTopOf="@id/campus_map"
        app:layout_constraintVertical_bias="0.88"
        app:tint="@color/pin_events" />

</androidx.constraintlayout.widget.ConstraintLayout>
