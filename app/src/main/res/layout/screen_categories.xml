<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 4: Categories - side panel opened from the filter button to choose which pins appear on the map -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ka_background">

    <include
        android:id="@+id/map"
        layout="@layout/include_campus_map"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="80dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/categories_panel"
        android:layout_width="220dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_outline_square"
        android:elevation="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btn_close_categories"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_close"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_minus" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/categories"
                android:textColor="@color/ka_text"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View style="@style/KA.Divider" />

        <TextView
            style="@style/KA.CategoryRow"
            android:text="@string/category_events"
            app:drawableStartCompat="@drawable/ic_pin"
            app:drawableTint="@color/pin_events" />

        <TextView
            style="@style/KA.CategoryRow"
            android:text="@string/category_alerts"
            app:drawableStartCompat="@drawable/ic_pin"
            app:drawableTint="@color/pin_alerts" />

        <TextView
            style="@style/KA.CategoryRow"
            android:text="@string/category_water"
            app:drawableStartCompat="@drawable/ic_pin"
            app:drawableTint="@color/pin_water" />

        <View style="@style/KA.Divider" />
    </LinearLayout>

    <include
        android:id="@+id/bottom_bar"
        layout="@layout/include_bottom_bar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
