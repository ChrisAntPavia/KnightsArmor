<?xml version="1.0" encoding="utf-8"?>
<!-- Placeholder campus map: UCF's concentric ring road layout -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ka_surface" />
            <stroke
                android:width="2dp"
                android:color="@color/ka_outline" />
        </shape>
    </item>
    <item
        android:bottom="28dp"
        android:left="28dp"
        android:right="28dp"
        android:top="28dp">
        <shape android:shape="oval">
            <solid android:color="@color/ka_background" />
            <stroke
                android:width="2dp"
                android:color="@color/ka_outline" />
        </shape>
    </item>
    <item
        android:bottom="96dp"
        android:left="96dp"
        android:right="96dp"
        android:top="96dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="@color/ka_text_secondary"
                android:dashGap="4dp"
                android:dashWidth="6dp" />
        </shape>
    </item>
</layer-list>
