<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: Knights Armor is dark in both day and night modes. -->
    <style name="Base.Theme.KnightsArmor" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/ka_gold</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSurface">@color/ka_surface</item>
        <item name="colorOnSurface">@color/ka_text</item>
        <item name="android:colorBackground">@color/ka_background</item>
        <item name="android:windowBackground">@color/ka_background</item>
        <item name="android:textColorPrimary">@color/ka_text</item>
        <item name="android:textColorSecondary">@color/ka_text_secondary</item>
    </style>

    <style name="Theme.KnightsArmor" parent="Base.Theme.KnightsArmor" />
</resources>
