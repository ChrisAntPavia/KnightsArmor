<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="KA.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/ka_outline</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/ka_text</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="KA.Input" parent="">
        <item name="android:background">@drawable/bg_outline_rounded</item>
        <item name="android:textColor">@color/ka_text</item>
        <item name="android:textColorHint">@color/ka_text_secondary</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="KA.NavButton" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:padding">14dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/ka_text</item>
    </style>

    <style name="KA.CategoryRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:textColor">@color/ka_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="KA.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/ka_outline</item>
    </style>
</resources>
